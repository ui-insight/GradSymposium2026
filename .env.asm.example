# Separate ASM deployment. Set a fresh secret/password before live use.
GPSA_DATABASE_URL=postgresql+asyncpg://asm:replace-before-live-use@db:5432/asm
GPSA_SECRET_KEY=replace-with-a-random-secret-before-live-use
GPSA_DEV_MODE=false
GPSA_SEED_HISTORICAL_EVENT=false
GPSA_CORS_ORIGINS=http://localhost:8081
HOST_PORT=8081
POSTGRES_USER=asm
POSTGRES_PASSWORD=replace-before-live-use
POSTGRES_DB=asm
POSTGRES_VOLUME_NAME=asm-2026-pgdata
DOCKER_SUBNET=10.95.0.0/24
